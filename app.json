{
  "expo": {
    "name": "Gesty",
    "slug": "gesty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gesty",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.joaquin.gesty",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16161A"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-lockup.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E10"
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
