{
  "expo": {
    "name": "Gesty",
    "slug": "gesty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gesty",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.joaquin.gesty",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16161A"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-lockup.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E0E10"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/06fe5d2f-2b81-4497-a8c9-85d49baad30b"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "06fe5d2f-2b81-4497-a8c9-85d49baad30b"
      }
    },
    "owner": "antoninojoaquin",
    "ios": {}
  }
}
